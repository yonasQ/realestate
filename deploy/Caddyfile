# Automatic HTTPS (Let's Encrypt) for {$DOMAIN}; www redirects to the apex.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# Caddy overwrites X-Forwarded-For with the real client IP (app runs with TRUST_PROXY=true).
	reverse_proxy app:3000 {
		header_up X-Forwarded-Host {host}
	}
	# Limit request bodies (admin uploads ≤ 16 MB; everything else is small).
	request_body {
		max_size 20MB
	}
	log {
		output stdout
		format json
	}
}
