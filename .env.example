# ---------------------------------------------------------------------------
# Copy to .env (development) or configure in your host's secret manager (production).
# Never commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string. Production: use a dedicated least-privilege role and sslmode=require if remote.
DATABASE_URL=postgres://realtor:realtor_dev_password@127.0.0.1:5435/realtor
DATABASE_POOL_MAX=10

# Public origin used for canonical URLs, sitemap, Open Graph and CSRF origin checks. https:// in production.
SITE_URL=http://localhost:3000

# 32+ random characters. Used to sign form tokens and hash IPs. Generate with: openssl rand -base64 48
APP_SECRET=

# Where uploaded and imported images are stored (mount a persistent volume here in production).
STORAGE_DIR=./storage

# Set to true only when running behind a reverse proxy you control (Caddy/Nginx/load balancer)
# that overwrites X-Forwarded-For. Otherwise client IPs can be spoofed.
TRUST_PROXY=false

LOG_LEVEL=info

# --- Inquiry notifications (optional; every inquiry is stored in the database and visible in /admin) ---
# Business inbox that receives new-inquiry notifications.
INQUIRY_NOTIFY_EMAIL=
# SMTP relay (Google Workspace, Zoho, Mailgun, Postmark, SES SMTP...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# e.g. "Website Inquiries <no-reply@yourdomain.com>" — domain must have SPF/DKIM for this sender.
SMTP_FROM=

# Optional CRM / automation webhook (HubSpot workflow, Zapier, Make, n8n...). Payload is HMAC-SHA256 signed.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Secret for the notification retry endpoint (POST /api/cron/notifications). 24+ characters.
CRON_SECRET=

# --- Optional Cloudflare Turnstile bot protection (set both or neither) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional privacy-friendly analytics (Plausible: cookieless, no consent banner required) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Local end-to-end tests only (Playwright). Never set in production. ---
# E2E_DATABASE_URL=postgres://realtor:realtor_dev_password@127.0.0.1:5435/realtor_e2e
# E2E_ADMIN_EMAIL=admin@example.test
# E2E_ADMIN_PASSWORD=
